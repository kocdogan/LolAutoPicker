<Window x:Class="LolAutoPicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LoL Auto Picker" 
        Height="740" Width="1050"
        MinHeight="740" MinWidth="1000" 
        Background="#111111" FontFamily="Consolas" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#00FF41"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="HeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="#FF007F"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="Foreground" Value="#FFFF00"/>
            <Setter Property="BorderBrush" Value="#00FF41"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="CaretBrush" Value="#00FF41"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#00FF41"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#222222"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="5"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#00FF41"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FF007F"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF007F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="0" ShadowDepth="4" Color="#000000" Opacity="1"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#00FF41"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="#00FF41" BorderThickness="4" Background="#1A1A1A" Padding="15,15,5,15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="0" ShadowDepth="6" Color="#000000"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock x:Name="lblPlayerSetup" Text="[ OYUNCU AYARLARI ]" Style="{StaticResource HeaderStyle}"/>

                <TextBlock x:Name="lblQueue" Text="> Kuyruk Türü:"/>
                <ComboBox x:Name="cmbQueue">
                    <ComboBoxItem Content="SoloQ" IsSelected="True"/>
                    <ComboBoxItem Content="Flex"/>
                </ComboBox>

                <TextBlock x:Name="lblBans" Text="> Yasaklamalar (Ban):" Foreground="#FF0044" Margin="0,10,0,0"/>
                <TextBox x:Name="txtBan1" Text="Malphite"/>
                <TextBox x:Name="txtBan2" Text="Viego"/>
                <TextBox x:Name="txtBan3" Text="Darius"/>

                <TextBlock x:Name="lblPicks" Text="> Seçimler (Pick):" Foreground="#00CCFF" Margin="0,10,0,0"/>
                <TextBox x:Name="txtPick1" Text="Talon"/>
                <TextBox x:Name="txtPick2" Text="Nasus"/>
                <TextBox x:Name="txtPick3" Text="Sion"/>

                <TextBlock x:Name="lblRoles" Text="> Koridor (1. ve 2.):" Margin="0,10,0,0"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="cmbRole1" Grid.Column="0" Margin="0,0,5,0">
                        <ComboBoxItem Content="TOP"/>
                        <ComboBoxItem Content="JUNGLE" IsSelected="True"/>
                        <ComboBoxItem Content="MIDDLE"/>
                        <ComboBoxItem Content="BOTTOM"/>
                        <ComboBoxItem Content="UTILITY"/>
                    </ComboBox>
                    <ComboBox x:Name="cmbRole2" Grid.Column="1" Margin="5,0,0,0">
                        <ComboBoxItem Content="TOP"/>
                        <ComboBoxItem Content="JUNGLE"/>
                        <ComboBoxItem Content="MIDDLE" IsSelected="True"/>
                        <ComboBoxItem Content="BOTTOM"/>
                        <ComboBoxItem Content="UTILITY"/>
                    </ComboBox>
                </Grid>

                <TextBlock x:Name="lblSpells" Text="> Büyüler:"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="cmbSpell1" Grid.Column="0" Margin="0,0,5,0" DisplayMemberPath="Key" SelectedValuePath="Value"/>
                    <ComboBox x:Name="cmbSpell2" Grid.Column="1" Margin="5,0,0,0" DisplayMemberPath="Key" SelectedValuePath="Value"/>
                </Grid>

                <TextBlock x:Name="lblRunes" Text="> Rün Sayfası:"/>
                <ComboBox x:Name="cmbRunes" Margin="0,0,0,15" DisplayMemberPath="Name" SelectedValuePath="Id"/>

                <Button x:Name="BtnCheckClient" Content="İSTEMCİYİ KONTROL ET" Click="BtnCheckClient_Click" Margin="0,0,0,10" Background="#222222" Foreground="#00CCFF" BorderBrush="#00CCFF"/>

                <Button x:Name="BtnFindMatch" Content="MAÇ ARAT" Click="BtnFindMatch_Click"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button x:Name="BtnLangTR" Content="TR" Click="BtnLangTR_Click" Width="60" Margin="0,0,5,0" Background="#FF007F" Foreground="White" BorderBrush="White"/>
                    <Button x:Name="BtnLangEN" Content="EN" Click="BtnLangEN_Click" Width="60" Margin="5,0,0,0" Background="#222222" Foreground="#00FF41" BorderBrush="#00FF41"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Margin="15,0" BorderBrush="#00CCFF" BorderThickness="4" Background="#0A0A0A" Padding="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="0" ShadowDepth="6" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="lblTerminal" Text="[ TERMİNAL ÇIKTISI ]" Foreground="#00CCFF" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" x:Name="txtStatus" Text="İSTEMCİ: BAĞLI DEĞİL" Foreground="Red" FontSize="14" VerticalAlignment="Center"/>
                </Grid>

                <ScrollViewer x:Name="LogScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="txtLogs" Foreground="#00FF41" FontFamily="Consolas" TextWrapping="Wrap" FontSize="12"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Column="2" BorderBrush="#FFFF00" BorderThickness="4" Background="#1A1A1A" Padding="15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="0" ShadowDepth="6" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="lblLeaderboard" Text="[ İSTATİSTİKLER ]" Style="{StaticResource HeaderStyle}" Foreground="#FFFF00"/>

                <ListBox x:Name="lstStats" Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,0,0,10" 
                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,8"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#FFFF00" BorderThickness="2" Background="#111111" Padding="10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="Background" Value="#222222"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Image Grid.Column="0" Source="{Binding ImageUrl}" Width="36" Height="36" Stretch="UniformToFill" Margin="0,0,15,0"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontSize="16"/>
                                        <TextBlock Text="{Binding ScoreStr}" Foreground="#AAAAAA" FontSize="12" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding WinRateStr}" Foreground="#00FF41" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button x:Name="BtnRefreshStats" Grid.Row="2" Content="YENİLE" Click="BtnRefreshStats_Click" Background="#222" Foreground="#FFFF00" BorderBrush="#FFFF00"/>
            </Grid>
        </Border>
    </Grid>
</Window>